#!/usr/bin/env bash
# Run the native suite locally on a deliberately selected disposable emulator.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [[ "${ANDROID_SERIAL:-}" != emulator-* ]]; then
  echo 'Set ANDROID_SERIAL=emulator-<port> to a disposable emulator; physical devices are refused.' >&2
  exit 2
fi
adb_command=(adb -s "$ANDROID_SERIAL")
if [[ "$("${adb_command[@]}" shell getprop ro.kernel.qemu | tr -d '\r')" != 1 ]]; then
  echo "Selected device is not an Android emulator." >&2
  exit 2
fi
if [[ "$("${adb_command[@]}" shell getprop sys.boot_completed | tr -d '\r')" != 1 ]]; then
  echo "Wait for the selected emulator to finish booting." >&2
  exit 2
fi
for setting in window_animation_scale transition_animation_scale animator_duration_scale; do
  "${adb_command[@]}" shell settings put global "$setting" 0
done
cd "$ROOT/android"
if [[ "${1:-}" == "--ci-app-lock" ]]; then
  # The workflow owns this fresh AVD. Gradle runs against all connected devices.
  [[ "${GITHUB_ACTIONS:-}" == true && -n "${RUNNER_TEMP:-}" ]]
  [[ "$("${adb_command[@]}" shell getprop ro.boot.qemu.avd_name | tr -d '\r')" == spunto-ci ]]
  [[ "$(adb devices | awk 'NR>1 && NF {print $1}')" == "$ANDROID_SERIAL" ]]
  results="$RUNNER_TEMP/spunto-native-junit"
  mkdir -p "$results"
  gradle=(./gradlew --no-daemon --max-workers=2 --no-parallel --no-watch-fs)
  args=(-Pandroid.testInstrumentationRunnerArguments.spuntoAppLockDisposable=yes
        -Pandroid.testInstrumentationRunnerArguments.notAnnotation=io.theficos.spunto.ManualFixture)
  "${gradle[@]}" "${args[@]}" :app:connectedDebugAndroidTest
  cp -R app/build/outputs/androidTest-results/connected "$results/no-pin"
  # This synthetic credential belongs only to the workflow's new emulator.
  pin=258036
  enrolled=$("${adb_command[@]}" shell locksettings set-pin "$pin")
  [[ "$enrolled" == *"set to"* ]]
  trap '"${adb_command[@]}" shell locksettings clear --old "$pin" >/dev/null' EXIT
  lock=io.theficos.spunto.AppLockTest
  cases="$lock#launcherAndSelectionStayLockedWithoutCreatingNotesAndWidgetTextStaysHidden,$lock#actualSystemCredentialCancellationAndSuccessfulPinUnlock,$lock#unsavedShareDraftSurvivesRelockAndIsAbsentFromLockedAccessibilityWindows,$lock#cancellingSettingsAuthenticationDoesNotExitOrChangeSetting"
  pin_result=0
  "${gradle[@]}" "${args[@]}" "-Pandroid.testInstrumentationRunnerArguments.spuntoAppLockPin=$pin" \
    "-Pandroid.testInstrumentationRunnerArguments.class=$cases" :app:connectedDebugAndroidTest || pin_result=$?
  cp -R app/build/outputs/androidTest-results/connected "$results/with-pin"
  if [[ "$pin_result" != 0 ]]; then exit "$pin_result"; fi
  python3 - "$results" <<'PYTHON'
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

expected = {
    "no-pin": {"backExitsLockScreenWhenPhoneAuthenticationIsUnavailable"},
    "with-pin": {"launcherAndSelectionStayLockedWithoutCreatingNotesAndWidgetTextStaysHidden",
                 "actualSystemCredentialCancellationAndSuccessfulPinUnlock",
                 "unsavedShareDraftSurvivesRelockAndIsAbsentFromLockedAccessibilityWindows",
                 "cancellingSettingsAuthenticationDoesNotExitOrChangeSetting"},
}
for mode, required in expected.items():
    passed = set()
    for report in (Path(sys.argv[1]) / mode).rglob("TEST-*.xml"):
        for case in ET.parse(report).iter("testcase"):
            if case.get("classname", "").endswith(".AppLockTest") and not any(
                case.find(tag) is not None for tag in ("error", "failure", "skipped")
            ):
                passed.add(case.get("name"))
    assert required <= passed, f"{mode}: missing successful lock tests {required - passed}"
PYTHON
  exit 0
fi
scripts/dgradle --no-daemon :app:assembleDebug :app:assembleDebugAndroidTest
# A disposable AVD can contain a debug build signed by another checkout. Reset
# only these debug identities before installation; the release identity stays.
for package in io.theficos.spunto.debug.test io.theficos.spunto.debug; do
  if "${adb_command[@]}" shell pm path "$package" | grep -q '^package:'; then
    "${adb_command[@]}" uninstall "$package"
  fi
done
"${adb_command[@]}" install -r app/build/outputs/apk/debug/app-debug.apk
"${adb_command[@]}" install -r app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk
# A fresh debug sandbox matches CI's disposable AVD. The release app has a
# separate package and is never cleared or uninstalled by this command.
"${adb_command[@]}" shell pm clear io.theficos.spunto.debug
"${adb_command[@]}" shell pm clear io.theficos.spunto.debug.test
instrument_args=()
if [[ -n "${SPUNTO_NATIVE_CLASS:-}" ]]; then
  instrument_args=(-e class "$SPUNTO_NATIVE_CLASS")
fi
log_file="${SPUNTO_NATIVE_LOG:-$(mktemp "${TMPDIR:-/tmp}/spunto-native.XXXXXX")}"
echo "Instrumentation output: $log_file"
"${adb_command[@]}" shell am instrument -w "${instrument_args[@]}" \
  io.theficos.spunto.debug.test/androidx.test.runner.AndroidJUnitRunner | tee "$log_file"
# adb/am can exit zero even when instrumentation fails or crashes. Require the
# runner's positive test summary as well as the absence of failure markers.
if grep -Eq 'FAILURES!!!|INSTRUMENTATION_FAILED|INSTRUMENTATION_RESULT: shortMsg=' "$log_file" || \
  ! grep -Eq '^OK \([1-9][0-9]* tests?\)' "$log_file"; then
  echo "Native tests failed or did not produce a non-empty successful summary: $log_file" >&2
  exit 1
fi
