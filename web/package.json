{
  "name": "spunto-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-budget.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "../server/.venv/bin/python scripts/export-openapi.py && openapi-typescript src/lib/openapi.json -o src/lib/api-types.ts && prettier --write src/lib/api-types.ts src/lib/openapi.json",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "format:check": "prettier --check src tests e2e scripts *.ts *.json index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "dompurify": "3.4.17",
    "openapi-fetch": "0.17.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
